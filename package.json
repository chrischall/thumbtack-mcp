{
  "name": "@chrischall/thumbtack-mcp",
  "version": "1.1.0",
  "description": "MCP server for Thumbtack — search local service pros and read pro profiles, ratings, reviews and credentials.",
  "type": "module",
  "mcpName": "io.github.chrischall/thumbtack-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/thumbtack-mcp.git"
  },
  "bin": {
    "thumbtack-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    ".mcp.json",
    "server.json",
    "mint.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --alias:zod/v4=./node_modules/zod/v4/index.cjs --platform=node --format=esm --external:dotenv --external:@fetchproxy/server --banner:js='import { createRequire as __createRequire } from \"module\"; const require = __createRequire(import.meta.url);' --outfile=dist/bundle.js",
    "dev": "node --env-file=.env dist/index.js",
    "test": "npm run typecheck && vitest run",
    "test:coverage": "npm run typecheck && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^1.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^18.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT"
}
